; Engine configuration file.
; Minimal E2E fixture — 无 autoload,避免 Godot headless 加载时编译外部 RPG demo
; 的 autoload 链(详见 e2e-full-tool-verification.test.ts 注释)。
config_version=5

[application]

config/name="MCP E2E Test Fixture"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"

; P0-2 (2026-09-11): dual-key file logging off — concurrent instances share user://logs,
; RotatedFileLogger rotate race makes abort look like engine_crashed (aigengame pit).
; Base key defaults false, but the .pc feature-tag override defaults TRUE on desktop and
; wins at startup — closing only the base key is a no-op.
[debug]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false
