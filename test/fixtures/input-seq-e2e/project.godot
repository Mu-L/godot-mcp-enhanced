; Engine configuration file.
; H1 (2026-08-20) send_input_sequence e2e fixture:最小项目,probe.gd 运行时注册
; action "jump"(physical SPACE),_physics_process 记录首次读到 pressed 的全局帧号。
; 注:game_bridge_install/qa run 会在运行时写入 [autoload] 段并放置 mcp_bridge.gd——
; 均为运行时产物,不入库(对齐 real-project 惯例,e2e afterAll / gitignore 兜底)。
config_version=5

[application]

config/name="input-seq-e2e"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

; P0-2 (2026-09-11): dual-key file logging off — concurrent instances share user://logs,
; RotatedFileLogger rotate race makes abort look like engine_crashed (aigengame pit).
; Base key defaults false, but the .pc feature-tag override defaults TRUE on desktop and
; wins at startup — closing only the base key is a no-op.
[debug]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false

[autoload]
MCPBridge="*res://mcp_bridge.gd"
