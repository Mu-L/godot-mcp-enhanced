; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="real-project"
config/version="0.20.0"
run/main_scene="res://scenes/2d/main_2d.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("godot_mcp_server")

[rendering]

renderer/rendering_method="gl_compatibility"

; P0-2 (2026-09-11): dual-key file logging off — concurrent instances share user://logs,
; RotatedFileLogger rotate race makes abort look like engine_crashed (aigengame pit).
; Base key defaults false, but the .pc feature-tag override defaults TRUE on desktop and
; wins at startup — closing only the base key is a no-op.
[debug]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false
