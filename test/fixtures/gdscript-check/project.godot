; Engine configuration file.
; M3c gdscript-check fixture — 最小空项目,仅启用 godot_mcp_server plugin 供 --import 编译检查。
; 手写(R5:features 段完整含 4.6 + 渲染器,不用 Godot 生成——本机无 Godot)。
; addons/ 由 check-gdscript.ts main() 每次运行时从源 addons/godot_mcp_server/ 复制(.gitignore 排除)。
config_version=5

[application]

config/name="M3c gdscript check"
config/features=PackedStringArray("4.6", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]

enabled=PackedStringArray("godot_mcp_server")
